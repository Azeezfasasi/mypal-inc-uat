# Copy this file to `.env` in the project root (not in src/) and fill in the values.
# Vite only reads .env files from the project root, and only on startup.
# Never put real keys in this file — it is committed to git.

# MyPal API base URL — must include /v1, the app appends paths like /businesses/all
VITE_API_BASE_URL=https://staging-api.mypal-inc.com/v1

# App API key, sent as the X-API-Key header. Ask the team for the value.
VITE_API_KEY=
